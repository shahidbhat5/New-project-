// Configuration
const SYMBOL = 'BTCUSDT';
const INTERVAL = '1h'; // 1h candles for Supertrend (adjust if needed)
let lastPrice = 0;
let lastSupertrend = null;
let lastRsi = null;

// Fetch 1h candles from Binance public API
async function fetchCandles() {
    try {
        const response = await fetch(`https://api.binance.com/api/v3/klines?symbol=${SYMBOL}&interval=${INTERVAL}&limit=100`);
        const data = await response.json();
        return data.map(candle => ({
            time: candle[0],
            open: parseFloat(candle[1]),
            high: parseFloat(candle[2]),
            low: parseFloat(candle[3]),
            close: parseFloat(candle[4]),
            volume: parseFloat(candle[5])
        }));
    } catch (error) {
        console.error('Error fetching candles:', error);
        return null;
    }
}

// Calculate Supertrend (period=10, multiplier=3)
function calculateSupertrend(candles) {
    if (!candles || candles.length < 20) return null;
    const period = 10;
    const multiplier = 3;
    const atr = [];
    const hl = [];
    
    // Calculate True Range and ATR
    for (let i = 1; i < candles.length; i++) {
        const high = candles[i].high;
        const low = candles[i].low;
        const prevClose = candles[i-1].close;
        const tr = Math.max(high - low, Math.abs(high - prevClose), Math.abs(low - prevClose));
        hl.push({ high, low, tr });
    }
    
    // Simple ATR (average of last 'period' TRs)
    const atrValues = [];
    for (let i = period - 1; i < hl.length; i++) {
        let sum = 0;
        for (let j = i - period + 1; j <= i; j++) sum += hl[j].tr;
        atrValues.push(sum / period);
    }
    
    // Basic bands and Supertrend direction
    let supertrend = [];
    let direction = 1; // 1 = up, -1 = down
    for (let i = period; i < candles.length; i++) {
        const idx = i - period; // index in atrValues
        const hl_idx = i - 1; // index in hl array
        const avg = (candles[i].high + candles[i].low) / 2;
        const upperBand = avg + multiplier * atrValues[idx];
        const lowerBand = avg - multiplier * atrValues[idx];
        
        if (i === period) {
            // First value: assume uptrend if close > upperBand? Usually we set initial direction based on first close
            supertrend[i] = upperBand;
            direction = candles[i].close > upperBand ? 1 : -1;
        } else {
            const prevUpper = avg_prev + multiplier * atrValues[idx-1];
            const prevLower = avg_prev - multiplier * atrValues[idx-1];
            const prevSuper = supertrend[i-1];
            const prevDir = direction;
            
            if (prevDir === 1) {
                if (candles[i].close <= prevSuper) {
                    direction = -1;
                    supertrend[i] = upperBand;
                } else {
                    direction = 1;
                    supertrend[i] = Math.max(prevSuper, lowerBand);
                }
            } else {
                if (candles[i].close >= prevSuper) {
                    direction = 1;
                    supertrend[i] = lowerBand;
                } else {
                    direction = -1;
                    supertrend[i] = Math.min(prevSuper, upperBand);
                }
            }
        }
        const avg_prev = (candles[i-1].high + candles[i-1].low) / 2;
    }
    
    // Get last direction and current price
    const lastCandle = candles[candles.length-1];
    const lastSuper = supertrend[supertrend.length-1];
    const currentPrice = lastCandle.close;
    
    if (!lastSuper) return null;
    
    const trend = currentPrice > lastSuper ? 'UP' : 'DOWN';
    return { trend, value: lastSuper, price: currentPrice };
}

// Calculate RSI (14)
function calculateRSI(candles, period = 14) {
    if (!candles || candles.length < period + 1) return null;
    let gains = 0, losses = 0;
    for (let i = candles.length - period; i < candles.length; i++) {
        const change = candles[i].close - candles[i-1].close;
        if (change >= 0) gains += change;
        else losses -= change;
    }
    const avgGain = gains / period;
    const avgLoss = losses / period;
    if (avgLoss === 0) return 100;
    const rs = avgGain / avgLoss;
    return 100 - (100 / (1 + rs));
}

// Determine buy/sell signal
function getSignal(price, stTrend, rsi) {
    if (!stTrend || rsi === null) return 'WAIT';
    // Strong buy: Supertrend UP and RSI > 50 and not overbought
    if (stTrend === 'UP' && rsi > 50 && rsi < 70) return 'BUY';
    // Strong sell: Supertrend DOWN and RSI < 50 and not oversold
    if (stTrend === 'DOWN' && rsi < 50 && rsi > 30) return 'SELL';
    // If extreme RSI, still follow trend but caution
    if (stTrend === 'UP' && rsi <= 50) return 'WATCH';
    if (stTrend === 'DOWN' && rsi >= 50) return 'WATCH';
    return 'NEUTRAL';
}

// Update UI
async function updateDashboard() {
    const candles = await fetchCandles();
    if (!candles) {
        document.getElementById('price').innerText = 'Error';
        return;
    }
    
    const currentCandle = candles[candles.length-1];
    const prevCandle = candles[candles.length-2];
    const price = currentCandle.close;
    const priceChange = ((price - prevCandle.close) / prevCandle.close * 100).toFixed(2);
    
    // Supertrend
    const st = calculateSupertrend(candles);
    const rsi = calculateRSI(candles);
    
    // Update DOM
    document.getElementById('price').innerText = '$' + price.toFixed(2);
    document.getElementById('change').innerText = (priceChange > 0 ? '+' : '') + priceChange + '%';
    document.getElementById('change').style.color = priceChange >= 0 ? '#0ecb81' : '#f6465d';
    
    if (st) {
        document.getElementById('supertrend').innerHTML = `${st.trend} <span style="font-size:0.9rem; color:#8d9bb5;">$${st.value.toFixed(2)}</span>`;
    } else {
        document.getElementById('supertrend').innerText = '--';
    }
    
    if (rsi !== null) {
        document.getElementById('rsi').innerText = rsi.toFixed(2);
    } else {
        document.getElementById('rsi').innerText = '--';
    }
    
    const signal = getSignal(price, st?.trend, rsi);
    const signalEl = document.getElementById('signal');
    signalEl.innerText = signal;
    signalEl.className = 'signal-value ' + 
        (signal === 'BUY' ? 'buy' : (signal === 'SELL' ? 'sell' : 'neutral'));
    
    const now = new Date();
    document.getElementById('timestamp').innerText = 'Last update: ' + now.toLocaleTimeString();
}

// Auto-refresh every 60 seconds
let interval = setInterval(updateDashboard, 60000);
updateDashboard();

// Manual refresh button
document.getElementById('refreshBtn').addEventListener('click', () => {
    updateDashboard();
});

// Stop interval when page unloads (optional)
window.addEventListener('beforeunload', () => clearInterval(interval));
